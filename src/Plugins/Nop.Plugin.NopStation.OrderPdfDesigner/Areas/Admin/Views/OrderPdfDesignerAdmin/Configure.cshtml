                                </div>
                            </div>
                            <div id="token-section-footer" class="token-helper">
                                <strong>Available Tokens:</strong>
                                <div class="token-btn-group">
                                    @foreach (var token in Model.AvailableTokens)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary insert-token-btn" 
                                                data-token="@token.Key" data-target="Footer">
                                            @token.Key
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer Description -->
                    <div class="card card-default">
                        <div class="card-header">
                            @T("Plugins.NopStation.OrderPdfDesigner.Fields.FooterDescription")
                            <button type="button" class="btn btn-sm btn-info float-right" onclick="showTokens('footerdesc')">
                                <i class="fas fa-code"></i> @T("Plugins.NopStation.OrderPdfDesigner.AvailableTokens")
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-12">
                                    <nop-editor asp-for="FooterDescription" asp-template="RichEditor" />
                                    <span asp-validation-for="FooterDescription"></span>
                                </div>
                            </div>
                            <div id="token-section-footerdesc" class="token-helper">
                                <strong>Available Tokens:</strong>
                                <div class="token-btn-group">
                                    @foreach (var token in Model.AvailableTokens)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary insert-token-btn" 
                                                data-token="@token.Key" data-target="FooterDescription">
                                            @token.Key
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- PDF Settings -->
                    <div class="card card-default">
                        <div class="card-header">
                            PDF Generation Settings
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="PaperSize" />
                                </div>
                                <div class="col-md-9">
                                    <nop-select asp-for="PaperSize" asp-items="@(new SelectList(Model.PaperSizes))" />
                                    <span asp-validation-for="PaperSize"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MarginTop" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MarginTop" />
                                    <span asp-validation-for="MarginTop"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MarginBottom" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MarginBottom" />
                                    <span asp-validation-for="MarginBottom"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MarginLeft" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MarginLeft" />
                                    <span asp-validation-for="MarginLeft"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="MarginRight" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="MarginRight" />
                                    <span asp-validation-for="MarginRight"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-label asp-for="EnableImageInsertion" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="EnableImageInsertion" />
                                    <span asp-validation-for="EnableImageInsertion"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Preview & Generate -->
                    <div class="card card-default">
                        <div class="card-header">
                            Preview & Generate PDF
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label>Order ID for Preview/PDF:</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="number" id="preview-order-id" class="form-control" placeholder="Enter Order ID" />
                                </div>
                                <div class="col-md-3">
                                    <button type="button" id="preview-btn" class="btn btn-info">
                                        <i class="fas fa-eye"></i> @T("Plugins.NopStation.OrderPdfDesigner.PreviewOrder")
                                    </button>
                                    <button type="button" id="generate-pdf-btn" class="btn btn-success">
                                        <i class="fas fa-file-pdf"></i> @T("Plugins.NopStation.OrderPdfDesigner.GeneratePdf")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<!-- Preview Modal -->
<div class="modal fade" id="preview-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Order PDF Preview</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="preview-content"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
