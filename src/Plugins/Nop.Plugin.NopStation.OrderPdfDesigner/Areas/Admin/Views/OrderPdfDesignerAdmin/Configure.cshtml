                    </div>

                    <!-- Preview & Generate -->
                    <div class="card card-default">
                        <div class="card-header">
                            Preview & Generate PDF
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <label>Order ID for Preview/PDF:</label>
                                </div>
                                <div class="col-md-6">
                                    <input type="number" id="preview-order-id" class="form-control" placeholder="Enter Order ID" />
                                </div>
                                <div class="col-md-3">
                                    <button type="button" id="preview-btn" class="btn btn-info">
                                        <i class="fas fa-eye"></i> @T("Plugins.NopStation.OrderPdfDesigner.PreviewOrder")
                                    </button>
                                    <button type="button" id="generate-pdf-btn" class="btn btn-success">
                                        <i class="fas fa-file-pdf"></i> @T("Plugins.NopStation.OrderPdfDesigner.GeneratePdf")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>

<!-- Preview Modal -->
<div class="modal fade" id="preview-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Order PDF Preview</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="preview-content"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="download-preview-pdf-btn" class="btn btn-success">
                    <i class="fas fa-download"></i> Download as PDF
                </button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Download preview as PDF button handler
    $(document).ready(function() {
        $('#download-preview-pdf-btn').click(function() {
            var orderId = $('#preview-order-id').val();
            if (!currentPreviewHtml) {
                alert('No preview available');
                return;
            }
            
            var $btn = $(this);
            var originalText = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Generating...');
            
            // Create temporary container
            var element = document.createElement('div');
            element.innerHTML = currentPreviewHtml;
            element.style.width = '210mm';
            element.style.padding = '10mm';
            element.style.background = 'white';
            
            var opt = {
                margin: [10, 10, 10, 10],
                filename: 'Order_' + orderId + '.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, letterRendering: true },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            
            html2pdf().set(opt).from(element).save()
                .then(function() {
                    $btn.prop('disabled', false).html(originalText);
                })
                .catch(function(error) {
                    console.error('PDF generation error:', error);
                    alert('Error generating PDF: ' + error.message);
                    $btn.prop('disabled', false).html(originalText);
                });
        });
    });
</script>
