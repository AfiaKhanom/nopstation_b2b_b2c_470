@using Nop.Core.Domain.Catalog;
@*@model OrderDetailsModel*@
@using NopStation.Plugin.B2B.B2BB2CFeatures.Model.OrderSummary
@model ErpOrderDetailsModel
@using Newtonsoft.Json
@using Nop.Core;
@using NopStation.Plugin.B2B.B2BB2CFeatures;
@using NopStation.Plugin.B2B.ERPIntegrationCore.Services;
@using NopStation.Plugin.B2B.ERPIntegrationCore.Enums

@inject IWorkContext workContext
@inject IErpAccountService erpAccountService
@inject IErpNopUserService erpNopUserService
@inject B2BB2CFeaturesSettings b2BB2CFeaturesSettings
@inject IErpOrderAdditionalDataService erpOrderService
@inject AddressSettings AddressSettings;

@{
    var currCustomer = await workContext.GetCurrentCustomerAsync();
    var erpAccountOfCurrCustomer = await erpAccountService.GetActiveErpAccountByCustomerIdAsync(currCustomer.Id);
    var erpNopUserOfCurrCustomer = await erpNopUserService.GetErpNopUserByCustomerIdAsync(currCustomer.Id);
    var isB2BUser = erpAccountOfCurrCustomer != null && erpNopUserOfCurrCustomer != null && erpNopUserOfCurrCustomer.ErpUserType == ErpUserType.B2BUser;
    var isB2CUser = erpNopUserOfCurrCustomer != null && erpNopUserOfCurrCustomer.ErpUserType == ErpUserType.B2CUser;
    var isERPOrder = false;
    var isQuoteOrder = false;
    var checkQuoteOrderStatus = false;
    var isQuoteExpired = true;
    var isQuoteAlreadyConverted = true;
    var hasQuoteExpireDate = false;
    var isQuoteRejectedorFailed = true;

    if (isB2BUser)
    {
        var b2bOrder = await erpOrderService.GetErpOrderAdditionalDataByNopOrderIdAsync(Model.Id);
        if (b2bOrder != null && (b2bOrder.ErpOrderType == ErpOrderType.B2BSalesOrder || b2bOrder.ErpOrderType == ErpOrderType.B2BQuote))
        {
            isERPOrder = b2bOrder.ErpOrderOriginType == ErpOrderOriginType.ERPOrder ? true : false;
            isQuoteOrder = b2bOrder.ErpOrderType == ErpOrderType.B2BSalesOrder ? false : true;
            if (isQuoteOrder)
            {
                checkQuoteOrderStatus = await erpOrderService.CheckQuoteOrderStatusAsync(b2bOrder);
                if (b2bOrder.QuoteExpiryDate != null)
                {
                    isQuoteExpired = DateTime.UtcNow.Date >= b2bOrder.QuoteExpiryDate.Value.Date ? true : false;
                    hasQuoteExpireDate = true;
                }
                isQuoteRejectedorFailed = b2bOrder.ERPOrderStatus == "Failed" || b2bOrder.ERPOrderStatus == "Rejected";
                isQuoteAlreadyConverted = b2bOrder.QuoteSalesOrderId.HasValue && b2bOrder.QuoteSalesOrderId.Value > 0;
            }
        }
    }
}

@{

    Layout = "_ColumnsOne";
    NopHtml.AddTitleParts(T("PageTitle.QuoteOrderDetails").Text);
    //page class
    NopHtml.AppendPageCssClassParts("html-order-details-page");
}

<div class="page order-details-page">
    <div class="page-title">
        <h1>@T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpOrderDetails.PublicView.NopQuoteInformation")</h1>
    </div>
    <div class="page-body">
        <div class="order-overview">
            <div class="order-number">
                @if (isERPOrder || !string.IsNullOrEmpty(Model.ERPOrderNumber) && Model.Id.ToString() != Model.ERPOrderNumber)
                {
                    <strong>@T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpOrderDetails.PublicView.NopQuoteNumber#")@Model.Id | @T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpOrderDetails.PublicView.ERPQuoteNumber#")@Model.ERPOrderNumber</strong>
                }
                else
                {
                    <strong>@T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpOrderDetails.PublicView.NopQuoteNumber#")@Model.Id</strong>
                }
            </div>
            <ul class="order-overview-content">
                <li class="order-date">
                    @T("Order.OrderDate"): @Model.CreatedOn.ToString("D")
                </li>
                <li class="order-status">
                    @T("Order.OrderStatus"): @Model.ERPOrderStatus
                </li>
                <li class="order-total">
                    @T("Order.OrderTotal"): <strong>@Model.TotalPriceWithOutSavingsExcTax</strong>
                </li>
            </ul>

        </div>
        @*  Billing Address*@
        <div class="order-details-area">
            <div class="billing-info-wrap">
                <div class="billing-info">
                    <div class="title">
                        <strong>@T("Order.BillingAddress")</strong>
                    </div>
                    <ul class="info-list">
                        <li class="name">
                            @Model.ErpBillingAddressModel.FirstName @Model.ErpBillingAddressModel.LastName
                        </li>
                        <li class="email">
                            @T("Order.Email"): @Model.ErpBillingAddressModel.Email
                        </li>
                        @if (Model.ErpBillingAddressModel.PhoneEnabled)
                        {
                            <li class="phone">
                                @T("Order.Phone"): @Model.ErpBillingAddressModel.PhoneNumber
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.FaxEnabled)
                        {
                            <li class="fax">
                                @T("Order.Fax"): @Model.ErpBillingAddressModel.FaxNumber
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.CompanyEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.Company))
                        {
                            <li class="company">
                                @Model.ErpBillingAddressModel.Company
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.StreetAddressEnabled)
                        {
                            <li class="address1">
                                @Model.ErpBillingAddressModel.Address1
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.StreetAddress2Enabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.Address2))
                        {
                            <li class="address2">
                                @Model.ErpBillingAddressModel.Address2
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.CityEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.City) ||
                        Model.ErpBillingAddressModel.CountyEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.County) ||
                        Model.ErpBillingAddressModel.StateProvinceEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.StateProvinceName) ||
                        Model.ErpBillingAddressModel.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.ZipPostalCode))
                        {
                            <li class="city-state-zip">
                                @if (Model.ErpBillingAddressModel.CityEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.City))
                                {
                                    @Model.ErpBillingAddressModel.City
                                    @if (Model.ErpBillingAddressModel.CountyEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.County) ||
                                   Model.ErpBillingAddressModel.StateProvinceEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.StateProvinceName) ||
                                   Model.ErpBillingAddressModel.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.ZipPostalCode))
                                    {
                                        <text>,</text>
                                    }
                                }
                                @if (Model.ErpBillingAddressModel.CountyEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.County))
                                {
                                    @Model.ErpBillingAddressModel.County
                                    @if (Model.ErpBillingAddressModel.StateProvinceEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.StateProvinceName) ||
                                   Model.ErpBillingAddressModel.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.ZipPostalCode))
                                    {
                                        <text>,</text>
                                    }
                                }
                                @if (Model.ErpBillingAddressModel.StateProvinceEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.StateProvinceName))
                                {
                                    @Model.ErpBillingAddressModel.StateProvinceName
                                    @if (Model.ErpBillingAddressModel.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.ZipPostalCode))
                                    {
                                        <text>,</text>
                                    }
                                }
                                @if (Model.ErpBillingAddressModel.ZipPostalCodeEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.ZipPostalCode))
                                {
                                    @Model.ErpBillingAddressModel.ZipPostalCode
                                }
                            </li>
                        }
                        @if (Model.ErpBillingAddressModel.CountryEnabled && !string.IsNullOrEmpty(Model.ErpBillingAddressModel.CountryName))
                        {
                            <li class="country">
                                @Model.ErpBillingAddressModel.CountryName
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.VatNumber))
                        {
                            <li class="vat">
                                <span class="label">
                                    @T("Order.VATNumber")
                                </span>
                                <span class="value">
                                    @Model.VatNumber
                                </span>
                            </li>
                        }
                        @if (!string.IsNullOrEmpty(Model.ErpBillingAddressModel.FormattedCustomAddressAttributes))
                        {
                            <li class="custom-attributes-view">
                                @Html.Raw(Model.ErpBillingAddressModel.FormattedCustomAddressAttributes)
                            </li>
                        }

                    </ul>
                </div>
                @*  Payment Methods *@
                @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                {
                    <div class="payment-method-info">
                        <div class="title">
                            <strong>@T("Order.Payment")</strong>
                        </div>
                        <ul class="info-list">
                            <li class="payment-method">
                                <span class="label">
                                    @T("Order.Payment.Method"):
                                </span>
                                <span class="value">
                                    @Model.PaymentMethod
                                </span>
                            </li>

                            <li class="payment-method-status">
                                <span class="label">
                                    @T("Order.Payment.Status"):
                                </span>
                                <span class="value">
                                    @Model.PaymentMethodStatus
                                </span>
                            </li>

                            @if (Model.CanRePostProcessPayment)
                            {
                                @*Complete payment (for redirection payment methods)*@
                                <li class="repost">
                                    <form asp-route="OrderDetails" method="post">
                                        <button type="submit" name="repost-payment" class="button-2 re-order-button">@T("Order.RetryPayment")</button>
                                        <p class="hint">
                                            <em>@T("Order.RetryPayment.Hint")</em>
                                        </p>
                                    </form>
                                </li>
                            }
                            @if (Model.CustomValues != null)
                            {
                                foreach (var item in Model.CustomValues)
                                {
                                    <li class="custom-value">
                                        <span class="label">
                                            @item.Key:
                                        </span>
                                        <span class="value">
                                            @(item.Value != null ? item.Value.ToString() : "")
                                        </span>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                }
            </div>

            <div class="shipping-info-wrap">
