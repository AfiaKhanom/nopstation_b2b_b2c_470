@using Newtonsoft.Json
@model ErpActivityLogsTypeSearchModel

@{
    //page title
    ViewBag.PageTitle = @T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpActivityLogs.ErpActivityLogsTypes.Title").Text;
    //active menu item (system name)
    NopHtml.SetActiveMenuItemSystemName("NopStation.B2BB2CFeatures.ErpActivityLogsTypes");
}

<form asp-controller="ErpActivityLogs" asp-action="SaveTypes" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpActivityLogs.ErpActivityLogsTypes.Title")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-save"></i>
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    <section class="content">
    <div class="container-fluid">
        <div class="card card-default">
            <div class="card-body">

                @await Html.PartialAsync("Table", new DataTablesModel
                {
                    Name = "erp-activityLogsType-grid",
                    Paging = false,
                    ServerSide = false,
                    Length = Model.PageSize,
                    LengthMenu = Model.AvailablePageSizes,
                    ColumnCollection = new List<ColumnProperty>
                    {
                        new ColumnProperty(nameof(ErpActivityLogsTypeModel.Name))
                        {
                            Title = T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpActivityLogsTypes.Fields.Name").Text,
                            AutoWidth = true
                        },
                        new ColumnProperty(nameof(ErpActivityLogsTypeModel.Enabled))
                        {
                            IsMasterCheckBox = true,
                            Title = T("Plugin.Misc.NopStation.B2BB2CFeatures.ErpActivityLogsTypes.Fields.Enabled").Text,
                            Width = "100",
                            ClassName = NopColumnClassDefaults.CenterAll,
                            Render = new RenderCheckBox("checkbox_activity_types")
                        }
                    },
                    Data = JsonConvert.SerializeObject(Model.ErpActivityLogsTypeListModel.Select(typeModel => new
                    {
                        typeModel.Id,
                        typeModel.Name,
                        Enabled = typeModel.Enabled
                    }).ToList())
                })
            </div>
        </div>
    </div>
    </section>
</form>