@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="UseERPIntegration" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="UseERPIntegration" />
            <span asp-validation-for="UseERPIntegration"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ERPTimeOutMilliseconds" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ERPTimeOutMilliseconds" />
            <span asp-validation-for="ERPTimeOutMilliseconds"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="MaxERPIntegrationOrderPlaceReties" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="MaxERPIntegrationOrderPlaceReties" />
            <span asp-validation-for="MaxERPIntegrationOrderPlaceReties"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="EnableLogOnErpCall" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="EnableLogOnErpCall" />
            <span asp-validation-for="EnableLogOnErpCall"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="MaintainUniqueCustomerReference" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="MaintainUniqueCustomerReference" />
            <span asp-validation-for="MaintainUniqueCustomerReference"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="ERPToDetermineDate" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="ERPToDetermineDate" />
            <span asp-validation-for="ERPToDetermineDate"></span>
        </div>
    </div>
</div>