@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
			<nop-override-store-checkbox asp-for="GoogleMapsApiKey_OverrideForStore" asp-input="GoogleMapsApiKey" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
            <nop-label asp-for="GoogleMapsApiKey" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="GoogleMapsApiKey" />
            <span asp-validation-for="GoogleMapsApiKey"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
			<nop-override-store-checkbox asp-for="Latitude_OverrideForStore" asp-input="Latitude" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
            <nop-label asp-for="Latitude" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Latitude" />
            <span asp-validation-for="Latitude"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
			<nop-override-store-checkbox asp-for="Longitude_OverrideForStore" asp-input="Longitude" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
            <nop-label asp-for="Longitude" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Longitude" />
            <span asp-validation-for="Longitude"></span>
        </div>
    </div>
</div>