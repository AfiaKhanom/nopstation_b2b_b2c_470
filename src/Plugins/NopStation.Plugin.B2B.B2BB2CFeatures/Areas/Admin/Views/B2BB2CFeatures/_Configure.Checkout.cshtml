@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CustomerRefrenceCheckoutAttributeId" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="CustomerRefrenceCheckoutAttributeId" />
            <span asp-validation-for="CustomerRefrenceCheckoutAttributeId"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="AllowAddressEditOnCheckoutForAll" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="AllowAddressEditOnCheckoutForAll" />
            <span asp-validation-for="AllowAddressEditOnCheckoutForAll"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="DeliveryDays" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="DeliveryDays" />
            <span asp-validation-for="DeliveryDays"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="CutoffTime" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="CutoffTime" />
            <span asp-validation-for="CutoffTime"></span>
        </div>
    </div>
