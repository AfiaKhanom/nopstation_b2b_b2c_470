@model ConfigurationModel

<div class="card-body">
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="SyncFromDate" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="SyncFromDate" />
            <input asp-for="SyncFromDate" class="form-control" type="date" pattern="\d{2}/\d{2}/\d{4}" placeholder="dd/mm/yyyy" hidden>
            <span asp-validation-for="SyncFromDate"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="NeedQuoteOrderCall" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="NeedQuoteOrderCall" /> 
            <span asp-validation-for="NeedQuoteOrderCall"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="StartProductSyncAfterLastSyncedProduct" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="StartProductSyncAfterLastSyncedProduct" />
            <span asp-validation-for="StartProductSyncAfterLastSyncedProduct"></span>
        </div>
    </div>
</div>