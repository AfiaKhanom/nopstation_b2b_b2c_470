@inject StafastSettings StafastSetings
@using System.Globalization

@if (StafastSetings.EnableCarouselsForDefaultEntityLists)
{
    NopHtml.AddPageCssClassParts("default-carousels-activated");

    <script asp-location="Footer">
        var myCustomSlider = document.querySelectorAll('.product-swiper');
        for (var i = 0; i < myCustomSlider.length; i++) {
            myCustomSlider[i].classList.add('product-swiper-' + i);
            var productSwiperSelect = ".product-swiper-" + i + " " + ".swiper";
            var defaultProductSwiper = new Swiper(productSwiperSelect, {
                slidesPerView: "auto",
                observer: true,
                observeParents: true,
                loop: @StafastSetings.EnableCarouselLoop.ToString().ToLower(),
                on: {
                    init: function (swiper) {
                        $(document).trigger({ type: "swiper_initialized", swiper: swiper });
                    },
                },
        @if (StafastSetings.EnableCarouselAutoPlay)
        {
            <text>
                    autoplay: {
                    delay: @StafastSetings.CarouselAutoPlayTimeout,
                    disableOnInteraction: false,
                    pauseOnMouseEnter: @StafastSetings.CarouselAutoPlayHoverPause.ToString().ToLower(),
                },
            </text>
        }
        @if (StafastSetings.EnableCarouselPagination)
        {
            <text>
                    pagination: {
                    el: ".product-swiper-" + i + " " + " .swiper-pagination",
                    type: "@(StafastSetings.PaginationType.ToString().ToLower())",
                    dynamicBullets: @StafastSetings.CarouselPaginationDynamicBullets.ToString().ToLower(),
                    dynamicMainBullets: @StafastSetings.CarouselPaginationDynamicMainBullets,
                    clickable: @StafastSetings.CarouselPaginationClickable.ToString().ToLower()
                                                    },
            </text>
        }
        @if (StafastSetings.EnableCarouselNavigation)
        {
            <text>
                    navigation: {
                    nextEl: ".product-swiper-" + i + " " + ".swiper-button-next",
                    prevEl: ".product-swiper-" + i + " " + ".swiper-button-prev",
                },
            </text>
        }
                        });
                }


        new Swiper(".home-page-categories", {
            slidesPerView: "auto",
            direction: 'horizontal',
            loop: @StafastSetings.EnableCarouselLoop.ToString().ToLower(),
            loopFillGroupWithBlank: true,
            on: {
                init: function (swiper) {
                    $(document).trigger({ type: "swiper_initialized", swiper: swiper });
                },
            },
        @if (StafastSetings.EnableCarouselAutoPlay)
        {
            <text>
                autoplay: {
                delay: @StafastSetings.CarouselAutoPlayTimeout,
                disableOnInteraction: false,
                pauseOnMouseEnter: @StafastSetings.CarouselAutoPlayHoverPause.ToString().ToLower(),
            },
            </text>
        }
        @if (StafastSetings.EnableCarouselPagination)
        {
            <text>
                pagination: {
                el: ".home-page-categories .swiper-pagination",
                type: "@(StafastSetings.PaginationType.ToString().ToLower())",
                dynamicBullets: @StafastSetings.CarouselPaginationDynamicBullets.ToString().ToLower(),
                dynamicMainBullets: @StafastSetings.CarouselPaginationDynamicMainBullets,
                clickable: @StafastSetings.CarouselPaginationClickable.ToString().ToLower()
                                        },
            </text>
        }
        @if (StafastSetings.EnableCarouselNavigation)
        {
            <text>
                navigation: {
                nextEl: ".home-page-categories .swiper-button-next",
                prevEl: ".home-page-categories .swiper-button-prev",
            },
            </text>
        }
                });
    </script>
}

@if (StafastSetings.EnableStickyHeader)
{
    NopHtml.AppendPageCssClassParts("sticky-header-added");
}

@if (StafastSetings.EnableImageLazyLoad)
{
    NopHtml.AppendScriptParts(ResourceLocation.Footer, "~/Plugins/NopStation.Plugin.Theme.Stafast/Content/js/lazyload.js");
    <script asp-location="Footer">
        new LazyLoad();
        $(document).ajaxStop(function () {
            new LazyLoad();
        });
        $(document).on('swiper_initialized', function () {
            new LazyLoad();
        });
    </script>
}