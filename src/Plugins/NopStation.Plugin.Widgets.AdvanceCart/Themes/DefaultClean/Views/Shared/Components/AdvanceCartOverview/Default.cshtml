@model AdvanceCartProductOverviewModel


<div class="buy-quantity-wrapper">
    @if (!Model.DisableBuyButton)
    {
        if (Model.EnableBuyNowButton)
        {
            <button type="button" class="buynow-btn" onclick="NopAdvanceCart.addproducttocart_catalog(@Model.Id, true, this);return false;">@T("NopStation.AdvanceCart.BuyNow")</button>
        }
        if (Model.AllowCustomersToSelectQuantityFromProductBox)
        {
            if (Model.AllowedQuantities.Count > 0)
            {
                <select name="EnteredQuantity" class="qty-dropdown" aria-label=@T("Products.Qty.AriaLabel")>
                    @foreach (var item in Model.AllowedQuantities)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>
            }
            else
            {
                <div class="qty-wrapper">
                    <button class="btn-decrease" onclick="decreaseProductQty(this)" type="button">-</button>
                    <input name="EnteredQuantity" value="@Model.EnteredQuantity" class="qty-input" type="text" aria-label=@T("Products.Qty.AriaLabel") />
                    <button class="btn-increase" onclick="increaseProductQty(this)" type="button">+</button>
                </div>
            }
        }

    }
</div>


